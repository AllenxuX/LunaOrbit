# LunaOrbit release runtime (api container). Example only - no secrets here.
# Secrets come from a Kubernetes Secret: DATABASE_URL, KITE_API_KEY.

# --- required ---
PLATFORM_MODE=information
INFORMATION_WORKSPACE_ID=lunaorbit
LUNAORBIT_RUNTIME_MODE=readonly-lab
DISCOVERY_MODE=readonly-lab
# postgres = release persistence (independent PostgreSQL, see POSTGRES.md). postgres-mock is development-only.
REGISTRY_MODE=postgres
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=disable   (SECRET)
# API listens on loopback; only the nginx container in the same Pod reaches it.
HTTP_ADDR=127.0.0.1:8081
KITE_LAB_VERSION=v0.16.0
# Kite is reached through nginx's loopback bridge (KITE_UPSTREAM in the web container).
KITE_BASE_URL=http://127.0.0.1:28080
# KITE_API_KEY=<read-only Kite key>   (SECRET)
# Exact Kafka hostnames: every bootstrap host AND every advertised broker host (max 16 entries).
KAFKA_LAB_ALLOWED_HOSTS=<k1-bootstrap-host>,<k1-broker-host>,...
KAFKA_LAB_ALLOWED_PORTS=9092
# CIDRs that contain the IPs those hostnames resolve to (Pod and/or Service CIDR).
KAFKA_LAB_ALLOWED_CIDRS=<pod-cidr>,<service-cidr>
INFORMATION_BROWSER_ORIGINS=http://lunaorbit.lluna.cn

# --- must stay as-is (information mode refuses anything else) ---
CHANGES_MODE=disabled
OBSERVABILITY_MODE=disabled
ENABLE_KITE_WRITES=false
ENABLE_KAFKA_WRITES=false

# --- optional ---
# Auto discovery limits (empty = every Kite cluster, every namespace except kube-system/kube-public/kube-node-lease)
# KITE_CLUSTERS=in-cluster
# KITE_EXCLUDE_CLUSTERS=
# KITE_NAMESPACES=
# KITE_EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease
# KITE_CLUSTER_POLL_SECONDS=45
# Startup alias bindings in auto mode (each entry needs k8s_cluster), JSON list:
# KAFKA_LAB_ALIAS_BINDINGS=[{"k8s_cluster":"in-cluster","namespace":"luna-kafka","workload_name":"mm2","alias":"source","bootstrap":"<host>:9092"},...]
# LOG_LEVEL=info

# --- web (nginx) container ---
# API_UPSTREAM=127.0.0.1:8081
# KITE_UPSTREAM=kite.kite-system.svc.cluster.local:8080
