server {
  listen 8088;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 300k;
  location / { try_files $uri $uri/ /index.html; add_header Cache-Control "no-cache"; }
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
  location /api/ { proxy_pass http://${API_UPSTREAM}; proxy_set_header Host $http_host; proxy_read_timeout 40s; }
  location = /healthz { proxy_pass http://${API_UPSTREAM}; proxy_set_header Host $http_host; }
}
# Loopback-only bridge to Kite's in-cluster http Service; reachable only from inside this Pod.
server {
  listen 127.0.0.1:28080;
  location / { proxy_pass http://${KITE_UPSTREAM}; proxy_read_timeout 10s; }
}
