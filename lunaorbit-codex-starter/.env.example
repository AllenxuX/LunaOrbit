# Current product: no-login shared information workspace.
PLATFORM_MODE=information
INFORMATION_WORKSPACE_ID=local-information
# Exact intranet hosts including port; empty keeps loopback access only.
INFORMATION_ALLOWED_HOSTS=
INFORMATION_BROWSER_ORIGINS=http://127.0.0.1:5173

# Synthetic local values only. Replace blank credentials locally; never commit .env.
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
ENABLE_KITE_WRITES=false
ENABLE_KAFKA_WRITES=false
POSTGRES_USER=lunaorbit_local
POSTGRES_DB=lunaorbit_local
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Development registry is disabled by default. Use the registry-backend task
# for volatile offline Mock. postgres-mock additionally needs process env below.
REGISTRY_MODE=disabled
DATABASE_URL=
DEV_SESSION_KEY=
DEV_BROWSER_ORIGIN=http://127.0.0.1:5173

# Optional Phase 01 CLI only. Go reads process environment, not this file.
# Real mode must be explicitly selected; leave blank for offline Mock.
KITE_BASE_URL=
KITE_ALLOWED_ORIGINS=
KITE_API_KEY=
KITE_CLUSTER_NAME=
KITE_NAMESPACE=
KITE_RESOURCE_NAME=

# Phase 03 synthetic offline discovery; requires Mock registry.
DISCOVERY_MODE=disabled

# Historical identity options below are not mounted in information mode.
# ldap/mock explicitly disable the legacy developer session fallback.
IDENTITY_MODE=dev
IDENTITY_MOCK_USERS=
LDAP_URL=
LDAP_ALLOWED_ADDRESSES=
LDAP_ALLOWED_CIDRS=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_CA_PEM=
LDAP_ROLE_GROUPS=
# Server-owned subject ID -> registration IDs; empty denies all approvals.
ACL_APPROVAL_SCOPES=

# Synthetic changes only; real Kite and Kafka write flags stay false.
CHANGES_MODE=disabled
CHANGE_SNAPSHOT_KEY=
CHANGE_APPROVAL_SCOPES=

# Bounded synthetic metrics, impact candidates and manual business lineage.
OBSERVABILITY_MODE=disabled

# Explicit experimental read-only lab runtime (volatile registry, loopback API).
# Set REGISTRY_MODE=mock and DISCOVERY_MODE=readonly-lab together; mock defaults stay unchanged.
LUNAORBIT_RUNTIME_MODE=
KITE_LAB_VERSION=
# In lab set KITE_LAB_VERSION=v0.16.0 and KITE_BASE_URL to the Kite origin (http/https, in-cluster names OK)
# inject KITE_API_KEY only in the process environment, never a committed file.
KAFKA_LAB_ALLOWED_CIDRS=
KAFKA_LAB_ALLOWED_HOSTS=
KAFKA_LAB_ALLOWED_PORTS=

# Optional readonly-lab catalog: JSON array of exactly two enabled PLAINTEXT CreateInput objects; no credentials.
KAFKA_LAB_REGISTRATIONS=

# Explicit isolated management mode only, never production defaults
# LUNAORBIT_RUNTIME_MODE=admin-lab
# CHANGES_MODE=lab
# CHANGE_LAB_CATALOG=<server-owned bounded target JSON>
# KAFKA_LAB_ALIAS_BINDINGS=<server-owned two-alias JSON>
# CHANGE_LAB_ALLOW_SELF_APPROVAL=true
# KITE_WRITE_API_KEY=<injected secret, never commit>

# KAFKA_LAB_ACL_SELF_APPROVAL=true
